# Postgres connection string. Locally: the docker-compose database.
# In production: the Neon *pooled* connection string (host contains "-pooler").
DATABASE_URL=postgres://clinic:clinic@localhost:5433/clinic

# Shared secret required in the X-API-Key header of every API request.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=change-me

# Base URL the web page's server code uses to call the API.
# Optional on Vercel: defaults to https://$VERCEL_PROJECT_PRODUCTION_URL.
API_BASE_URL=http://localhost:3000
